# ========================================================
# JARVIS PERSONAL ASSISTANT CONFIGURATION
# ========================================================

# Google Gemini API Key (from Google AI Studio: aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Telegram Bot (for chatting and voice notes on your phone)
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Your personal Telegram numeric ID (get from @userinfobot on Telegram)
TELEGRAM_USER_ID=

# Assistant Configuration
ASSISTANT_NAME=Jarvis
USER_NAME=Sir

# Desktop Voice & Wake-Word
ENABLE_WAKE_WORD=true
WAKE_WORD_THRESHOLD=0.5
# MIC_DEVICE_INDEX=  # Leave empty to use system default microphone
